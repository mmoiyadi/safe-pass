{
  "name": "password-manager",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "pnpm -r test",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter backend db:migrate",
    "db:migrate:status": "pnpm --filter backend db:migrate:status",
    "demo": "tsx scripts/demo-zero-knowledge.ts",
    "db:roundtrip": "tsx --env-file-if-exists=.env scripts/db-roundtrip.ts",
    "db:reset": "bash scripts/db-reset.sh",
    "dev": "bash scripts/dev.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "eslint": "^9.13.0",
    "prettier": "^3.3.3",
    "tsx": "4.19.2",
    "typescript": "5.6.3",
    "typescript-eslint": "^8.11.0"
  }
}
